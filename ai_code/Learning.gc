array[float] clear_array(array[float] arr){
	int l=len(arr);
	int i=0;
	lbl_clear_array:
	if (i == l)
		goto ret_clear_array;
	arr[i]=0.;
	i=i+1;
	goto lbl_clear_array;
	ret_clear_array:
	return arr
}

float dW0[28*28*20] = clear_array(W0);
float db0[20] = clear_array(b0);
float dW1[20*20] = clear_array(W1);
float db1[20] = clear_array(b1);
float dW2[28*28*20] = clear_array(W2);
float db2[28*28*20] = clear_array(b2);

