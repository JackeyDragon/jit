array[float] sigmoid(array[float] vector){
	int l = len(vector);
	int i = 0;
	lbl_sigmoid:
	if (i == l)
		goto ret_sigmoid;
	vector[i] = 1. / (1.+ exp(0. - vector[i]) );
	i=i+1;
	goto lbl_sigmoid;
	ret_sigmoid:
	return vector;
}

array[float] sigmoid_grad(array[float] x, array[float] grad_output){
	x = sigmoid(x);
	int l=len(x);
	int i =0;
	lbl_sigmoid_grad:
	if (i == l)
		goto ret_sigmoid_grad;
	x[i] = grad_output[i]*s[i]*(1-s[i]);
	i=i+1;
	goto lbl_sigmoid_grad;
	ret_sigmoid_grad:
	return x;
}

array[float] forward_dense(array[float] in, array[float] out, ind idx){
	if(idx==0)
		goto lbl_0_forward_dense;
	if(idx==1)
		goto lbl_1_forward_dense;
	if(idx ==2)
		goto lvl_2_forward_dense;
	goto ret_forward_dense;
	
	lbl_0_forward_dense:
	out = mat_vec_prod(W0,in,out);
	out = add_vec(out,b0);
	goto ret_forward_dense;
	
	lbl_1_forward_dense:
	out = mat_vec_prod(W1,in,out);
	out = add_vec(out,b1);
	goto ret_forward_dense;
	
	lbl_2_forward_dense:
	out = mat_vec_prod(W2,in,out);
	out = add_vec(out,b2);
	goto ret_forward_dense;
	
	ret_forward_dense:
	return out;
}
